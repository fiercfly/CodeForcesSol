#include <bits/stdc++.h>
using namespace std;
 
 
int main(){
    int T;
    cin>>T;
    while(T--){
        int n, k;
        cin>>n>>k;
 
        string ans= "No";
 
        vector<int> arr(n);
        for(int i=0; i<n; i++){
            cin>>arr[i];
            if(arr[i] == k){
                ans= "Yes";
            }
        }
 
        cout<<ans<<endl;
        
    }
    return 0;
}